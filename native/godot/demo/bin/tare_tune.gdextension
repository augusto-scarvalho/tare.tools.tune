[configuration]

entry_symbol = "tare_tune_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/tare_tune.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/tare_tune.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libtare_tune.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtare_tune.linux.template_release.x86_64.so"
macos.debug = "res://bin/libtare_tune.macos.template_debug.framework"
macos.release = "res://bin/libtare_tune.macos.template_release.framework"
